    private void OpenChangePassword()
    {
        _userMenuOpen = false;
        _cpCurrent = _cpNew = _cpConfirm = _cpError = "";
        _cpVisible = true;
    }

    private async Task SaveChangePassword()
    {
        _cpError = "";
        if (string.IsNullOrEmpty(_cpCurrent)) { _cpError = "กรุณากรอกรหัสผ่านปัจจุบัน"; return; }
        if (_cpNew.Length < 6) { _cpError = "รหัสผ่านใหม่ต้องมีอย่างน้อย 6 ตัวอักษร"; return; }
        if (_cpNew != _cpConfirm) { _cpError = "รหัสผ่านใหม่ทั้งสองครั้งไม่ตรงกัน"; return; }

        var userName = _user?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                       ?? _user?.Identity?.Name ?? "";
        if (string.IsNullOrEmpty(userName)) { _cpError = "ไม่พบข้อมูลผู้ใช้"; return; }

        _cpSaving = true;
        try
        {
            var basePath = Env.IsProduction() ? "/ENG4_System" : "";
            var client = HttpFactory.CreateClient();
            var res = await client.PostAsJsonAsync(
                $"http://cptsvs552.canon-pt.co.th{basePath}/api/reset/change",
                new { userName, currentPassword = _cpCurrent, newPassword = _cpNew });

            var data = await res.Content.ReadFromJsonAsync<ChangeResp>();
            if (data is null || !data.success) { _cpError = data?.message ?? "เปลี่ยนรหัสผ่านไม่สำเร็จ"; return; }

            _cpVisible = false;
            Nav.NavigateTo("Logout", forceLoad: true);   // เปลี่ยนแล้ว logout ให้ login ใหม่
        }
        catch
        {
            _cpError = "เกิดข้อผิดพลาดในการเชื่อมต่อ";
        }
        finally
        {
            _cpSaving = false;
        }
    }

    private record ChangeResp(bool success, string? message);

    private async Task OpenRequestAccess()
    {
        _userMenuOpen = false;
        _raError = "";
        _raSelected.Clear();
        _raVisible = true;
        _raLoading = true;

        var userName = _user?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                       ?? _user?.Identity?.Name ?? "";
        try
        {
            var basePath = Env.IsProduction() ? "/ENG4_System" : "";
            var client = HttpFactory.CreateClient();
            var data = await client.GetFromJsonAsync<RequestAccessData>(
                $"http://cptsvs552.canon-pt.co.th{basePath}/api/request/menus/{userName}");
            _raMenus = data?.Menus ?? new();
        }
        catch { _raError = "โหลดรายการเมนูไม่สำเร็จ"; }
        finally { _raLoading = false; }
    }

    private void ToggleMenu(string col, bool on)
    {
        if (on) _raSelected.Add(col);
        else _raSelected.Remove(col);
    }

    private async Task SubmitRequestAccess()
    {
        _raError = "";
        if (_raSelected.Count == 0) { _raError = "กรุณาเลือกเมนูที่ต้องการขอสิทธิ์อย่างน้อย 1 รายการ"; return; }

        var userName = _user?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                       ?? _user?.Identity?.Name ?? "";
        _raSaving = true;
        try
        {
            var basePath = Env.IsProduction() ? "/ENG4_System" : "";
            var client = HttpFactory.CreateClient();
            var res = await client.PostAsJsonAsync(
                $"http://cptsvs552.canon-pt.co.th{basePath}/api/request/menus",
                new { userName, selectedColumns = _raSelected.ToList() });

            var d = await res.Content.ReadFromJsonAsync<ReqResp>();
            if (d is null || !d.success) { _raError = d?.message ?? "ส่งคำขอไม่สำเร็จ"; return; }

            Snackbar.Add(d.message, Severity.Success);
            _raVisible = false;
        }
        catch { _raError = "เกิดข้อผิดพลาดในการเชื่อมต่อ"; }
        finally { _raSaving = false; }
    }

    private void HandleLogout()
    {
        _userMenuOpen = false;
        Nav.NavigateTo("Logout", forceLoad: true);
    }

    private record ReqResp(bool success, string? message);
