    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask == null) return;

        var auth = await AuthStateTask;

        _user = auth.User;
        _fullName = auth.User.FindFirst("FullName")?.Value ?? auth.User.Identity?.Name ?? "";
        _shortName = auth.User.FindFirst("ShortName")?.Value ?? _fullName;
        _department = auth.User.FindFirst("DeptNameFull")?.Value ?? auth.User.FindFirst("Department")?.Value ?? "";
        _isAdmin = auth.User.FindFirst("Perm_Admin")?.Value == "True";

        // กรองระบบตามสิทธิ์ — ถ้า claim ไม่มีหรือเป็น "True" ให้แสดง
        _visibleSystems = GetSystems()
            .Where(s =>
            {
                var permClaim = auth.User.FindFirst(s.PermClaim)?.Value;
                // ถ้าไม่มี Claim นี้ = ระบบเก่า/ไม่ได้กำหนด → ซ่อน
                // ถ้ามีและเป็น "True" → แสดง
                return permClaim == "True";
            })
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await LoadAnnouncementsAsync();
            StateHasChanged();
        }
        catch { }
    }

    private async Task LoadAnnouncementsAsync()
    {
        try
        {
            await using var db = DbFactory.CreateDbContext();
            _announcements = await db.SysAnnouncements
                .Where(a => a.IsActive)
                .OrderBy(a => a.SortOrder)
                .ThenByDescending(a => a.CreatedDate)
                .Take(10)
                .ToListAsync();
        }
        catch { }
    }

