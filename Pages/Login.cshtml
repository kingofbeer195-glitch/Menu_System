    <!-- ===== Register script ===== -->
    <script>
        let regIsNewUser = false;
        let regEmpIdVal = '';

        function openRegister() {
            document.getElementById('registerModal').style.display = 'flex';
            document.getElementById('regError').innerText = '';
            document.getElementById('regDetail').style.display = 'none';
            document.getElementById('regEmpId').value = '';
            document.getElementById('regMenuList').innerHTML = '';
        }
        function closeRegister() {
            document.getElementById('registerModal').style.display = 'none';
        }
        function regErr(msg) { document.getElementById('regError').innerText = msg || ''; }

        async function regLookup() {
            regErr('');
            const empId = document.getElementById('regEmpId').value.trim();
            if (!empId) { regErr('กรุณากรอกรหัสพนักงาน'); return; }

            const btn = document.getElementById('regSearchBtn');
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span>';

            try {
                const res = await fetch('api/register/lookup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ empId: empId })
                });
                const d = await res.json();
                if (!d.success) { regErr(d.message); return; }

                regIsNewUser = d.isNewUser;
                regEmpIdVal = d.empId;

                document.getElementById('regName').value = d.fullName;
                document.getElementById('regDiv').value = d.division;
                document.getElementById('regDept').value = d.department;
                document.getElementById('regPosition').value = d.position;
                document.getElementById('regEmail').value = d.email;
                document.getElementById('regUserName').value = d.userName;

                // New user → โชว์ Tel + Password
                document.getElementById('regNewUserFields').style.display =
                    d.isNewUser ? 'flex' : 'none';

                // render menu checkboxes
                const list = document.getElementById('regMenuList');
                list.innerHTML = '';
                d.menus.forEach((m, i) => {
                    const wrap = document.createElement('label');
                    wrap.className = 'reg-menu-item' + (m.alreadyGranted ? ' granted' : '');
                    wrap.innerHTML = `
                        <input type="checkbox" value="${m.column}"
                            ${m.alreadyGranted ? 'checked' : ''} />
                        <span class="reg-menu-label">
                            <span class="name">${m.name}</span>
                            ${m.eng4Only ? '<span class="badge">ENG4</span>' : ''}
                            ${m.alreadyGranted ? '<span class="badge" style="background:#e8f5e9;color:#2e7d32;">มีสิทธิ์แล้ว</span>' : ''}
                            <br><span class="detail">${m.detail || ''}</span>
                        </span>`;
                    list.appendChild(wrap);
                });

                document.getElementById('regDetail').style.display = 'block';
            } catch (err) {
                regErr('เกิดข้อผิดพลาดในการเชื่อมต่อ');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }

                async function regSubmit() {
            regErr('');

            const checks = document.querySelectorAll('#regMenuList input[type=checkbox]:checked');
            const selected = Array.from(checks).map(c => c.value);

            if (selected.length === 0) { regErr('กรุณาเลือกเมนูที่ต้องการเข้าถึงอย่างน้อย 1 รายการ'); return; }

            let tel = '', pass = '';
            if (regIsNewUser) {
                tel = document.getElementById('regTel').value.trim();  // Tel ไม่บังคับ
                pass = document.getElementById('regPass').value;
                const confirm = document.getElementById('regConfirm').value;

                // ตรวจกฎ Password
                const pwError = validatePassword(pass);
                if (pwError) { regErr(pwError); return; }

                if (pass !== confirm) { regErr('รหัสผ่านทั้งสองครั้งไม่ตรงกัน'); return; }
            }

            const btn = document.getElementById('regSubmitBtn');
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span>กำลังลงทะเบียน...';

            try {
                const res = await fetch('api/register/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        empId: regEmpIdVal,
                        tel: tel,
                        password: pass,
                        selectedColumns: selected
                    })
                });
                const d = await res.json();
                if (!d.success) { regErr(d.message); return; }

                alert(d.message + '\nUser Name: ' + d.userName);
                closeRegister();
            } catch (err) {
                regErr('เกิดข้อผิดพลาดในการเชื่อมต่อ');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }

        // คืน error message ถ้าไม่ผ่าน, คืน '' ถ้าผ่าน
        function validatePassword(pw) {
            if (pw.length < 6) return 'รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร';
            return '';
        }

    </script>

    <!-- ===== Forgot Password Scrips ===== -->
    <script>
        let fpCountdownTimer = null;
        let fpUserName = "";

        function openForgot() {
            document.getElementById('forgotModal').style.display = 'flex';
            fpShowStep(1);
            document.getElementById('fpError').innerText = '';
        }
        function closeForgot() {
            document.getElementById('forgotModal').style.display = 'none';
            if (fpCountdownTimer) clearInterval(fpCountdownTimer);
        }
        function fpShowStep(n) {
            document.getElementById('fpStep1').style.display = n === 1 ? 'block' : 'none';
            document.getElementById('fpStep2').style.display = n === 2 ? 'block' : 'none';
            document.getElementById('fpStep3').style.display = n === 3 ? 'block' : 'none';
        }
        function fpErr(msg) {
            document.getElementById('fpError').innerText = msg || '';
        }

        async function fpRequest() {
            fpErr('');
            const user = document.getElementById('fpUser').value.trim() || fpUserName;
            if (!user) { fpErr('กรุณากรอก Username'); return; }
            fpUserName = user;

            // หา element ปุ่มที่กด (Step1 = ส่งรหัสยืนยัน, Step2 = ส่งใหม่)
            const btn = event.currentTarget;
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span>กำลังส่ง...';

            try {
                const res = await fetch('api/forgot/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: user })
                });
                const data = await res.json();

                if (!data.success) { fpErr(data.message); return; }

                document.getElementById('fpEmail').innerText = data.maskedEmail;
                fpShowStep(2);
                fpStartCountdown();
            } catch (err) {
                fpErr('เกิดข้อผิดพลาดในการเชื่อมต่อ');
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }

        async function fpVerify() {
            fpErr('');
            const otp = document.getElementById('fpOtp').value.trim();
            if (otp.length !== 6) { fpErr('กรุณากรอกรหัส 6 หลัก'); return; }

            const res = await fetch('api/forgot/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: fpUserName, otp: otp })
            });
            const data = await res.json();

            if (!data.success) { fpErr('รหัสไม่ถูกต้องหรือหมดอายุ'); return; }

            if (fpCountdownTimer) clearInterval(fpCountdownTimer);
            fpShowStep(3);
        }

        async function fpSave() {
            fpErr('');
            const newPass = document.getElementById('fpNewPass').value;
            const confirmPass = document.getElementById('fpConfirmPass').value;
            const otp = document.getElementById('fpOtp').value.trim();

            if (newPass.length < 4) { fpErr('รหัสผ่านต้องมีอย่างน้อย 4 ตัวอักษร'); return; }
            if (newPass !== confirmPass) { fpErr('รหัสผ่านทั้งสองครั้งไม่ตรงกัน'); return; }

            const res = await fetch('api/forgot/reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: fpUserName, otp: otp, newPassword: newPass })
            });
            const data = await res.json();

            if (!data.success) { fpErr(data.message); return; }

            alert('เปลี่ยนรหัสผ่านสำเร็จ! กรุณาเข้าสู่ระบบใหม่');
            closeForgot();
        }

        function fpStartCountdown() {
            let sec = 300;
            const el = document.getElementById('fpCountdown');
            const verifyBtn = document.getElementById('fpVerifyBtn');
            const resendBtn = document.getElementById('fpResendBtn');
            verifyBtn.disabled = false;
            resendBtn.style.display = 'none';

            if (fpCountdownTimer) clearInterval(fpCountdownTimer);
            fpCountdownTimer = setInterval(() => {
                sec--;
                el.innerText = Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0');
                if (sec <= 0) {
                    clearInterval(fpCountdownTimer);
                    el.innerText = 'หมดอายุ';
                    verifyBtn.disabled = true;
                    resendBtn.style.display = 'block';
                }
            }, 1000);
        }
    </script>

    <!-- ===== Reset Password Scrips ===== -->
    <script>

        // function getApiUrl(path) {
        //     const base = document.querySelector('base')?.getAttribute('href') || '/';
        //     return base.replace(/\/$/, '') + '/' + path;
        // }

        function openReset() {
            document.getElementById('resetModal').style.display = 'flex';
            document.getElementById('rpError').innerText = '';
            document.getElementById('rpUser').value = '';
            document.getElementById('rpCurrent').value = '';
            document.getElementById('rpNew').value = '';
            document.getElementById('rpConfirm').value = '';
        }
        function closeReset() {
            document.getElementById('resetModal').style.display = 'none';
        }

                async function rpSave() {
            const errEl = document.getElementById('rpError');
            errEl.innerText = '';

            const user = document.getElementById('rpUser').value.trim();
            const current = document.getElementById('rpCurrent').value;
            const newPass = document.getElementById('rpNew').value;
            const confirm = document.getElementById('rpConfirm').value;

            if (!user) { errEl.innerText = 'กรุณากรอก Username'; return; }
            if (!current) { errEl.innerText = 'กรุณากรอกรหัสผ่านปัจจุบัน'; return; }
            if (newPass.length < 4) { errEl.innerText = 'รหัสผ่านใหม่ต้องมีอย่างน้อย 4 ตัวอักษร'; return; }
            if (newPass !== confirm) { errEl.innerText = 'รหัสผ่านใหม่ทั้งสองครั้งไม่ตรงกัน'; return; }

            const btn = event.currentTarget;
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span>กำลังบันทึก...';

            try {
                const res = await fetch('api/reset/change', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        userName: user,
                        currentPassword: current,
                        newPassword: newPass
                    })
                });
                const data = await res.json();

                if (!data.success) { errEl.innerText = data.message; return; }

                alert('เปลี่ยนรหัสผ่านสำเร็จ! กรุณาเข้าสู่ระบบใหม่');
                closeReset();
            } catch (err) {
                errEl.innerText = 'เกิดข้อผิดพลาดในการเชื่อมต่อ';
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }
    </script>

    @* Login Loading *@
    <script>
        document.querySelector('form[method="post"]').addEventListener('submit', function () {
            const btn = document.getElementById('loginBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="btn-spinner"></span>กำลังเข้าสู่ระบบ...';
        });
    </script>

</body>
</html>
