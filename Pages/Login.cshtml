@page "/Login"
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ENG4 System - เข้าสู่ระบบ</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', 'THSarabunNew', Tahoma, Arial, sans-serif;
            background: linear-gradient(135deg, #0D47A1 0%, #1565C0 50%, #1976D2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 48px 40px 40px;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
        }

        .logo-section {
            text-align: center;
            margin-bottom: 36px;
        }

        .logo-circle {
            width: 72px;
            height: 72px;
            /* background: linear-gradient(135deg, #1565C0, #1976D2); */
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            /* box-shadow: 0 8px 24px rgba(21, 101, 192, 0.4); */
        }

            .logo-circle svg {
                width: 36px;
                height: 36px;
                fill: white;
            }

        .site-title {
            font-size: 22px;
            font-weight: 700;
            color: #1A237E;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .site-subtitle {
            font-size: 14px;
            color: #78909C;
            font-weight: 400;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #455A64;
            margin-bottom: 6px;
            letter-spacing: 0.3px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #CFD8DC;
            border-radius: 8px;
            font-size: 15px;
            font-family: inherit;
            color: #263238;
            background: #FAFAFA;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            outline: none;
        }

            .form-control:focus {
                border-color: #1976D2;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.15);
            }

            .form-control::placeholder {
                color: #B0BEC5;
            }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #1565C0, #1976D2);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
            box-shadow: 0 4px 16px rgba(21, 101, 192, 0.4);
            margin-top: 8px;
            letter-spacing: 0.5px;
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(21, 101, 192, 0.5);
            }

            .btn-login:active {
                transform: translateY(0);
                opacity: 0.92;
            }

        .error-alert {
            background: #FFEBEE;
            border: 1px solid #EF9A9A;
            border-left: 4px solid #F44336;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #C62828;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .footer-text {
            text-align: center;
            margin-top: 24px;
            color: #90A4AE;
            font-size: 12px;
        }

        .divider {
            height: 1px;
            background: #ECEFF1;
            margin: 24px 0;
        }
    </style>
