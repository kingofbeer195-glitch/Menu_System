    <style>
        .fp-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .fp-card {
            background: #fff;
            border-radius: 16px;
            padding: 32px;
            width: 380px;
            max-width: 90%;
            position: relative;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        .fp-close {
            position: absolute;
            top: 12px;
            right: 16px;
            border: none;
            background: none;
            font-size: 26px;
            cursor: pointer;
            color: #999;
        }

        .fp-head {
            text-align: center;
            margin-bottom: 20px;
        }

        .fp-icon {
            font-size: 42px;
            margin-bottom: 8px;
        }

        .fp-head h3 {
            margin: 4px 0;
            color: #1a2a6c;
        }

        .fp-head p {
            color: #888;
            font-size: 13px;
            margin: 4px 0;
        }

        .fp-timer {
            color: #d32f2f !important;
            font-weight: 600;
        }

        .fp-input {
            width: 100%;
            padding: 8px 10px;
            margin-bottom: 6px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 14px;
            box-sizing: border-box;
        }

        .fp-readOnly {
            background: #e9e9e9;
        }

            .fp-input:focus {
                outline: none;
                border-color: #1a2a6c;
            }

        .fp-otp {
            text-align: center;
            letter-spacing: 12px;
            font-size: 22px;
            font-weight: bold;
        }

        .fp-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: #1a2a6c;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
            margin-top: 6px;
        }

            .fp-btn:hover {
                background: #2c3e9f;
            }

            .fp-btn:disabled {
                background: #aaa;
                cursor: not-allowed;
            }

        .fp-btn-text {
            width: 100%;
            padding: 8px;
            border: none;
            background: none;
            color: #1a2a6c;
            cursor: pointer;
            margin-top: 4px;
            text-decoration: underline;
        }

        .fp-error {
            color: #d32f2f;
            font-size: 13px;
            text-align: center;
            margin-top: 12px;
            font-weight: 600;
        }
        /* ลิงก์เปิด modal */
        .fp-link {
            color: #bd5b5b;
            font-size: 13px;
            cursor: pointer;
            text-decoration: underline;
            background: none;
            border: none;
        }

        /* ===== Loading Spinner ===== */
        .btn-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: btn-spin 0.6s linear infinite;
            vertical-align: middle;
            margin-right: 8px;
        }

        @@keyframes btn-spin {
            to { transform: rotate(360deg); }
        }

        .btn-login:disabled,
        .fp-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .reg-field {
            margin-bottom: 10px;
            width:100%;
        }

            .reg-field label {
                display: block;
                font-size: 12px;
                color: #666;
                margin-bottom: 4px;
                font-weight: 600;
            }

        .reg-menu-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 8px 10px;
            border: 1px solid #eee;
            border-radius: 8px;
            margin-bottom: 6px;
        }

            .reg-menu-item input[type=checkbox] {
                margin-top: 3px;
                width: 16px;
                height: 16px;
            }

            .reg-menu-item.granted {
                background: #f1f8e9;
                border-color: #c5e1a5;
            }

        .reg-menu-label {
            font-size: 13px;
        }

            .reg-menu-label .name {
                font-weight: 600;
                color: #333;
            }

            .reg-menu-label .detail {
                color: #999;
                font-size: 12px;
            }

            .reg-menu-label .badge {
                font-size: 10px;
                background: #e3f2fd;
                color: #1565c0;
                padding: 1px 6px;
                border-radius: 8px;
                margin-left: 6px;
            }

        .reg-grid2 {
            display: flex;
            gap: 10px;
        }

        .pw-info {
            display: inline-block;
            margin-left: 6px;
            color: #1a2a6c;
            font-size: 12px;
            cursor: help;
            position: relative;
            /* vertical-align: middle; */
            background: #c7cbf7;
            padding: 2px 8px;
            border-radius: 50%;
        }

        .pw-tooltip {
            display: none;
            position: absolute;
            left: 50%;
            bottom: 130%;
            transform: translateX(-50%);
            width: 230px;
            background: #263238;
            color: #fff;
            font-size: 12px;
            font-weight: 400;
            line-height: 1.7;
            text-align: left;
            padding: 10px 12px;
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
            z-index: 10000;
            white-space: normal;
        }

            /* ลูกศรชี้ลง */
            .pw-tooltip::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                transform: translateX(-50%);
                border: 6px solid transparent;
                border-top-color: #263238;
            }

        .pw-info:hover .pw-tooltip,
        .pw-info:focus .pw-tooltip {
            display: block;
        }

    </style>
    <style>
        .pw-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

            .pw-wrap .fp-input {
                padding-right: 40px; /* เว้นที่ให้ปุ่มตา */
                margin-bottom: 0;
                flex: 1;
            }

        .pw-eye {
            position: absolute;
            right: 8px;
            border: none;
            background: none;
            cursor: pointer;
            font-size: 16px;
            padding: 4px;
            opacity: 0.6;
